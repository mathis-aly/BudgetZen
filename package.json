{
  "name": "budget-zen-pwa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "setup": "test -f .env || echo 'DATABASE_URL=\"file:./dev.db\"' > .env && npx prisma generate && npx prisma db push",
    "db:backup": "mkdir -p backups && cp prisma/dev.db backups/dev_$(date +%Y%m%d_%H%M%S).db",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "@xyflow/react": "^13.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "prisma": "^6.8.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
